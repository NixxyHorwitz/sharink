{
  "manifest_version": 3,
  "name": "Sharink - Kirim Link Antar Perangkat",
  "version": "1.0.0",
  "description": "Kirim link sekejap dari satu browser ke browser di perangkat lain menggunakan Pair Code.",
  "permissions": [
    "storage",
    "notifications",
    "tabs",
    "activeTab",
    "alarms",
    "contextMenus"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "send-current-tab": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Kirim tab aktif langsung ke perangkat paired"
    }
  }
}
